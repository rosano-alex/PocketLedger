{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The server is emitted by esbuild (see the `build` script), so tsc is
    // used purely as a type checker here.
    "noEmit": true
  },
  // A single `*`, so only the wire contract at the top of shared/src is seen.
  // The folders below it are client logic — React, zustand, the DOM — and
  // the server neither imports nor can type-check them.
  "include": ["src/**/*.ts", "tests/**/*.ts", "../shared/src/*.ts"]
}
