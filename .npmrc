# gluestack-ui declares `react-native` as a peer dependency. This is a
# web-only app: `react-native` is aliased to `react-native-web` in
# vite.config.ts, so the native package must not be installed (it would pull
# in its own React 19 peer and ~200MB of native tooling for no benefit).
# Legacy peer resolution keeps npm from auto-installing those peers.
legacy-peer-deps=true
