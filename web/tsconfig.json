{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    // webpack + Babel do the emitting; tsc is the type checker only.
    "noEmit": true,
    // gluestack-ui resolves `react-native` to react-native-web on the web, so
    // types must follow the same redirect the bundler applies.
    "paths": {
      "react-native": ["../node_modules/react-native-web/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../shared/src/**/*.ts"]
}
